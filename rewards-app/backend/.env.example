PORT=4007

# ชื่อฐานข้อมูลคือ line — ถ้ายังไม่มี คำสั่ง go run ./cmd/migrate จะสร้างให้อัตโนมัติ
# แก้ชื่อผู้ใช้กับรหัสผ่านให้ตรงกับ PostgreSQL ในเครื่องคุณ
DATABASE_URL=postgres://postgres:postgres@localhost:5432/line

JWT_SECRET=เปลี่ยนค่านี้ก่อนขึ้นใช้งานจริง

# ตอน dev หน้าเว็บยิงผ่าน proxy ของ vite จึงเป็น origin เดียวกัน ไม่ต้องตั้ง CORS
# ตั้งค่านี้เฉพาะตอนที่หน้าเว็บกับ API อยู่คนละ origin เช่น
# CLIENT_ORIGIN=https://192.168.1.50:4008
CLIENT_ORIGIN=*

# ---------- การแปลเนื้อหาอัตโนมัติ ----------
# ผู้ดูแลระบบกรอกข้อมูลเป็นภาษาไทยอย่างเดียว ระบบแปลเป็นอังกฤษและญี่ปุ่นให้เอง
#
# TRANSLATE_PROVIDER
#   auto      (ค่าเริ่มต้น) มี TRANSLATE_URL ก็ใช้ LibreTranslate ไม่มีก็ลองออกเน็ต
#   libre     LibreTranslate ที่ติดตั้งเองในวงแลน — แนะนำที่สุด ข้อมูลไม่ออกนอกองค์กร
#   google    จุดเชื่อมต่อสาธารณะ ไม่ต้องใช้กุญแจ เหมาะกับงานภายในปริมาณไม่มาก
#   mymemory  บริการฟรี มีโควตาจำกัดต่อวัน
#   offline   ไม่เรียกเน็ตเลย ใช้คลังคำในตัวโปรแกรมอย่างเดียว
#
# ออกเน็ตไม่ได้ก็ใช้งานได้ปกติ ระบบจะตกไปใช้คลังคำในตัวโปรแกรมเอง
# แค่คำแปลจะหยาบกว่า และไม่มีช่องว่างให้ผู้ใช้เห็นแน่นอน
TRANSLATE_PROVIDER=auto

# ที่อยู่ของ LibreTranslate เช่น http://192.168.1.60:5000
# เปิด service ชื่อ translate ใน docker-compose.prod.yml แล้วใส่ http://translate:5000
TRANSLATE_URL=

# กุญแจของบริการแปล (LibreTranslate บางเครื่องตั้งไว้ / MyMemory ใช้เป็นอีเมล)
TRANSLATE_KEY=

# ระยะห่างระหว่างรอบแปลเบื้องหลัง หน่วยเป็นวินาที
TRANSLATE_INTERVAL=60
