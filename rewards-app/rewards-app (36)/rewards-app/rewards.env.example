# คัดลอกเป็น rewards.env แล้วแก้ค่าก่อนรัน docker compose -f docker-compose.prod.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=เปลี่ยนรหัสผ่านนี้
POSTGRES_DB=line

# host ชื่อ db คือชื่อ service ใน docker-compose
DATABASE_URL=postgres://postgres:เปลี่ยนรหัสผ่านนี้@db:5432/line
JWT_SECRET=เปลี่ยนค่านี้เป็นข้อความสุ่มยาวๆ
PORT=4007
CLIENT_ORIGIN=*
