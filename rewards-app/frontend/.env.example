# ปกติไม่ต้องตั้งค่านี้ — ปล่อยว่างไว้ ระบบเลือกให้เอง
#   โหมด dev    ยิงผ่าน /api ให้ vite ส่งต่อไป backend พอร์ต 4007
#   build แล้ว  ยิงที่ origin เดียวกับหน้าเว็บ แล้วให้ nginx ส่งต่อ
#
# ตั้งเฉพาะกรณี backend อยู่คนละเครื่องกับหน้าเว็บ เช่น
# VITE_API_URL=https://192.168.1.50:4007
#
# ถ้าหน้าเว็บเป็น https แต่ backend เป็น http เบราว์เซอร์จะบล็อก (mixed content)
# กรณีนั้นให้ใช้ VITE_API_PROXY_TARGET แทน แล้วปล่อย VITE_API_URL ว่างไว้
VITE_API_URL=
