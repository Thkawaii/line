# คัดลอกเป็น rewards.env แล้วแก้ค่าก่อนรัน docker compose -f docker-compose.prod.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=เปลี่ยนรหัสผ่านนี้
POSTGRES_DB=line

# host ชื่อ db คือชื่อ service ใน docker-compose
DATABASE_URL=postgres://postgres:เปลี่ยนรหัสผ่านนี้@db:5432/line
JWT_SECRET=เปลี่ยนค่านี้เป็นข้อความสุ่มยาวๆ
PORT=4007
CLIENT_ORIGIN=*

# ---------- การแปลเนื้อหาอัตโนมัติ ----------
# auto | libre | google | mymemory | offline  (ดูคำอธิบายเต็มใน backend/.env.example)
TRANSLATE_PROVIDER=auto

# เปิด service ชื่อ translate ใน docker-compose.prod.yml แล้วใส่ค่านี้
# TRANSLATE_URL=http://translate:5000
TRANSLATE_URL=

TRANSLATE_KEY=
TRANSLATE_INTERVAL=60
