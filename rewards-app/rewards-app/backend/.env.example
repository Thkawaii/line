PORT=4007

# ชื่อฐานข้อมูลคือ line — ถ้ายังไม่มี คำสั่ง go run ./cmd/migrate จะสร้างให้อัตโนมัติ
# แก้ชื่อผู้ใช้กับรหัสผ่านให้ตรงกับ PostgreSQL ในเครื่องคุณ
DATABASE_URL=postgres://postgres:postgres@localhost:5432/line

JWT_SECRET=เปลี่ยนค่านี้ก่อนขึ้นใช้งานจริง

# ตอน dev หน้าเว็บยิงผ่าน proxy ของ vite จึงเป็น origin เดียวกัน ไม่ต้องตั้ง CORS
# ตั้งค่านี้เฉพาะตอนที่หน้าเว็บกับ API อยู่คนละ origin เช่น
# CLIENT_ORIGIN=https://192.168.1.50:4008
CLIENT_ORIGIN=*
